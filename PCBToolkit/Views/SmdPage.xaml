<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PCBToolkit.Views.SmdPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#0B0F14">

    <Grid RowDefinitions="100,*">

        <!-- EN: SMD page header area -->
        <!-- TR: SMD sayfası üst başlık alanı -->
        <Grid
            Grid.Row="0"
            HeightRequest="100"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">

            <!-- EN: Header background image -->
            <!-- TR: Header arka plan görseli -->
            <Image
                Source="smd_header.png"
                Aspect="AspectFill"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                InputTransparent="True" />

            <!-- EN: Dark overlay for text readability -->
            <!-- TR: Yazı okunabilirliği için koyu katman -->
            <BoxView
                BackgroundColor="#650B0F14"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                InputTransparent="True" />

            <!-- EN: Header content -->
            <!-- TR: Header içeriği -->
            <Grid
                Padding="18,12,18,12"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="16">

                <!-- EN: Back navigation button -->
                <!-- TR: Geri dönüş butonu -->
                <Border
                    Grid.Column="0"
                    WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="#B5101820"
                    Stroke="#4DB8FF"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 14"
                    HorizontalOptions="Start"
                    VerticalOptions="Center">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>

                    <Grid
                        WidthRequest="44"
                        HeightRequest="44"
                        InputTransparent="True">

                        <!-- EN: Geometric back arrow -->
                        <!-- TR: Geometrik geri oku -->
                        <Path
                            Data="M 15,9 L 8,16 L 15,23"
                            Stroke="#4DB8FF"
                            StrokeThickness="3"
                            StrokeLineCap="Round"
                            StrokeLineJoin="Round"
                            WidthRequest="23"
                            HeightRequest="32"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            InputTransparent="True" />

                    </Grid>

                </Border>

                <!-- EN: Page title -->
                <!-- TR: Sayfa başlığı -->
                <Label
                    Grid.Column="1"
                    Text="SMD Araçları"
                    TextColor="White"
                    FontSize="24"
                    FontAttributes="Bold"
                    VerticalOptions="Center"
                    LineBreakMode="TailTruncation"
                    MaxLines="1" />

            </Grid>

            <!-- EN: Header bottom divider -->
            <!-- TR: Header alt ayırıcı -->
            <BoxView
                HeightRequest="1"
                BackgroundColor="#17384D"
                HorizontalOptions="Fill"
                VerticalOptions="End"
                InputTransparent="True" />

        </Grid>

        <!-- EN: Scrollable main content -->
        <!-- TR: Kaydırılabilir ana içerik -->
        <ScrollView
            Grid.Row="1"
            HorizontalScrollBarVisibility="Never"
            VerticalScrollBarVisibility="Default">

            <VerticalStackLayout
                Padding="18,18,18,30"
                Spacing="15">

                <!-- EN: Calculation tools category -->
                <!-- TR: Hesaplama araçları kategorisi -->
                <HorizontalStackLayout
                    Margin="3,4,0,0"
                    Spacing="9"
                    VerticalOptions="Center">

                    <!-- EN: Calculator icon -->
                    <!-- TR: Hesap makinesi ikonu -->
                    <Grid
                        WidthRequest="23"
                        HeightRequest="25"
                        VerticalOptions="Center">

                        <Border
                            BackgroundColor="#101D26"
                            Stroke="#4DB8FF"
                            StrokeThickness="1.3"
                            StrokeShape="RoundRectangle 4">

                            <Grid
                                Padding="4"
                                RowDefinitions="6,*"
                                RowSpacing="3">

                                <Border
                                    Grid.Row="0"
                                    BackgroundColor="#16374B"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 1" />

                                <Grid
                                    Grid.Row="1"
                                    RowDefinitions="*,*"
                                    ColumnDefinitions="*,*"
                                    RowSpacing="2"
                                    ColumnSpacing="2">

                                    <BoxView
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        BackgroundColor="#4DB8FF"
                                        CornerRadius="1" />

                                    <BoxView
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        BackgroundColor="#4DB8FF"
                                        CornerRadius="1" />

                                    <BoxView
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        BackgroundColor="#4DB8FF"
                                        CornerRadius="1" />

                                    <BoxView
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        BackgroundColor="#4DB8FF"
                                        CornerRadius="1" />

                                </Grid>

                            </Grid>

                        </Border>

                    </Grid>

                    <Label
                        Text="HESAPLAMA ARAÇLARI"
                        TextColor="#4DB8FF"
                        FontSize="11"
                        FontAttributes="Bold"
                        CharacterSpacing="1.5"
                        VerticalTextAlignment="Center"
                        LineBreakMode="TailTruncation"
                        MaxLines="1" />

                </HorizontalStackLayout>

                <!-- EN: Resistor code tool -->
                <!-- TR: Direnç kodu aracı -->
                <Border
                    x:Name="ResistorCodeCard"
                    HeightRequest="112"
                    BackgroundColor="#101820"
                    Stroke="#1E3444"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    HorizontalOptions="Fill">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="OnResistorCodeTapped" />
                    </Border.GestureRecognizers>

                    <Grid>

                        <Image
                            Source="smd_resistor_code.png"
                            Aspect="AspectFill"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            InputTransparent="True" />

                        <BoxView
                            BackgroundColor="#99101820"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            InputTransparent="True" />

                        <Grid
                            Padding="18,16"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="12">

                            <VerticalStackLayout
                                Grid.Column="0"
                                VerticalOptions="Center"
                                Spacing="5">

                                <Label
                                    Text="Direnç Kodu"
                                    TextColor="White"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1" />

                                <Label
                                    Text="3/4 hane · R kodu · EIA-96"
                                    TextColor="#A0ADB7"
                                    FontSize="11"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1" />

                                <Label
                                    Text="103  →  10 kΩ"
                                    TextColor="#4DB8FF"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1" />

                            </VerticalStackLayout>

                            <!-- EN: Forward navigation arrow -->
                            <!-- TR: İleri yön oku -->
                            <Label
                                Grid.Column="1"
                                Text="›"
                                TextColor="#4DB8FF"
                                FontSize="34"
                                FontAttributes="Bold"
                                VerticalOptions="Center"
                                InputTransparent="True" />

                        </Grid>

                    </Grid>

                </Border>

                <!-- EN: Capacitor code tool -->
                <!-- TR: Kapasitör kodu aracı -->
                <Border
                    x:Name="CapacitorCodeCard"
                    HeightRequest="112"
                    BackgroundColor="#101820"
                    Stroke="#1E3444"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    HorizontalOptions="Fill">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="OnCapacitorCodeTapped" />
                    </Border.GestureRecognizers>

                    <Grid>

                        <Image
                            Source="smd_capacitor_code.png"
                            Aspect="AspectFill"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            InputTransparent="True" />

                        <BoxView
                            BackgroundColor="#99101820"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            InputTransparent="True" />

                        <Grid
                            Padding="18,16"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="12">

                            <VerticalStackLayout
                                Grid.Column="0"
                                VerticalOptions="Center"
                                Spacing="5">

                                <Label
                                    Text="Kapasitör Kodu"
                                    TextColor="White"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1" />

                                <Label
                                    Text="Kapasitör kodunu değere dönüştür"
                                    TextColor="#A0ADB7"
                                    FontSize="11"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1" />

                                <Label
                                    Text="104  →  100 nF"
                                    TextColor="#4DB8FF"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1" />

                            </VerticalStackLayout>

                            <!-- EN: Forward navigation arrow -->
                            <!-- TR: İleri yön oku -->
                            <Label
                                Grid.Column="1"
                                Text="›"
                                TextColor="#4DB8FF"
                                FontSize="34"
                                FontAttributes="Bold"
                                VerticalOptions="Center"
                                InputTransparent="True" />

                        </Grid>

                    </Grid>

                </Border>

                <!-- EN: Package tools category -->
                <!-- TR: Paket araçları kategorisi -->
                <HorizontalStackLayout
                    Margin="3,9,0,0"
                    Spacing="9"
                    VerticalOptions="Center">

                    <!-- EN: Microchip icon -->
                    <!-- TR: Mikroçip ikonu -->
                    <Grid
                        WidthRequest="26"
                        HeightRequest="23"
                        ColumnDefinitions="4,18,4"
                        RowDefinitions="*,*,*"
                        VerticalOptions="Center">

                        <BoxView
                            Grid.Row="0"
                            Grid.Column="0"
                            HeightRequest="2"
                            BackgroundColor="#4DB8FF"
                            VerticalOptions="Center" />

                        <BoxView
                            Grid.Row="1"
                            Grid.Column="0"
                            HeightRequest="2"
                            BackgroundColor="#4DB8FF"
                            VerticalOptions="Center" />

                        <BoxView
                            Grid.Row="2"
                            Grid.Column="0"
                            HeightRequest="2"
                            BackgroundColor="#4DB8FF"
                            VerticalOptions="Center" />

                        <Border
                            Grid.RowSpan="3"
                            Grid.Column="1"
                            BackgroundColor="#101D26"
                            Stroke="#4DB8FF"
                            StrokeThickness="1.3"
                            StrokeShape="RoundRectangle 3">

                            <BoxView
                                WidthRequest="4"
                                HeightRequest="4"
                                BackgroundColor="#4DB8FF"
                                CornerRadius="2"
                                HorizontalOptions="Start"
                                VerticalOptions="Start"
                                Margin="3" />

                        </Border>

                        <BoxView
                            Grid.Row="0"
                            Grid.Column="2"
                            HeightRequest="2"
                            BackgroundColor="#4DB8FF"
                            VerticalOptions="Center" />

                        <BoxView
                            Grid.Row="1"
                            Grid.Column="2"
                            HeightRequest="2"
                            BackgroundColor="#4DB8FF"
                            VerticalOptions="Center" />

                        <BoxView
                            Grid.Row="2"
                            Grid.Column="2"
                            HeightRequest="2"
                            BackgroundColor="#4DB8FF"
                            VerticalOptions="Center" />

                    </Grid>

                    <Label
                        Text="PAKET ARAÇLARI"
                        TextColor="#4DB8FF"
                        FontSize="11"
                        FontAttributes="Bold"
                        CharacterSpacing="1.5"
                        VerticalTextAlignment="Center"
                        LineBreakMode="TailTruncation"
                        MaxLines="1" />

                </HorizontalStackLayout>

                <!-- EN: Package finder tool -->
                <!-- TR: Paket bulucu aracı -->
                <Border
                    x:Name="PackageFinderCard"
                    HeightRequest="112"
                    BackgroundColor="#101820"
                    Stroke="#1E3444"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    HorizontalOptions="Fill">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="OnPackageFinderTapped" />
                    </Border.GestureRecognizers>

                    <Grid>

                        <Image
                            Source="smd_package_finder.png"
                            Aspect="AspectFill"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            InputTransparent="True" />

                        <BoxView
                            BackgroundColor="#99101820"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            InputTransparent="True" />

                        <Grid
                            Padding="18,16"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="12">

                            <VerticalStackLayout
                                Grid.Column="0"
                                VerticalOptions="Center"
                                Spacing="5">

                                <Label
                                    Text="Paket Bulucu"
                                    TextColor="White"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1" />

                                <Label
                                    Text="0201 · 0402 · 0603 · 0805 · 1206"
                                    TextColor="#A0ADB7"
                                    FontSize="11"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1" />

                                <Label
                                    Text="0805  →  2.0 × 1.25 mm"
                                    TextColor="#4DB8FF"
                                    FontSize="13"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1" />

                            </VerticalStackLayout>

                            <!-- EN: Forward navigation arrow -->
                            <!-- TR: İleri yön oku -->
                            <Label
                                Grid.Column="1"
                                Text="›"
                                TextColor="#4DB8FF"
                                FontSize="34"
                                FontAttributes="Bold"
                                VerticalOptions="Center"
                                InputTransparent="True" />

                        </Grid>

                    </Grid>

                </Border>

                <!-- EN: Package reference tool -->
                <!-- TR: Paket referans aracı -->
                <Border
                    x:Name="PackageReferenceCard"
                    HeightRequest="112"
                    BackgroundColor="#101820"
                    Stroke="#1E3444"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    HorizontalOptions="Fill">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="OnPackageReferenceTapped" />
                    </Border.GestureRecognizers>

                    <Grid>

                        <Image
                            Source="smd_package_reference.png"
                            Aspect="AspectFill"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            InputTransparent="True" />

                        <BoxView
                            BackgroundColor="#99101820"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            InputTransparent="True" />

                        <Grid
                            Padding="18,16"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="12">

                            <VerticalStackLayout
                                Grid.Column="0"
                                VerticalOptions="Center"
                                Spacing="5">

                                <Label
                                    Text="Paket Referansı"
                                    TextColor="White"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1" />

                                <Label
                                    Text="SOT · SOIC · QFN · QFP · BGA · LGA"
                                    TextColor="#A0ADB7"
                                    FontSize="11"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1" />

                                <Label
                                    Text="Paket özellikleri ve teknik bilgiler"
                                    TextColor="#4DB8FF"
                                    FontSize="13"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1" />

                            </VerticalStackLayout>

                            <!-- EN: Forward navigation arrow -->
                            <!-- TR: İleri yön oku -->
                            <Label
                                Grid.Column="1"
                                Text="›"
                                TextColor="#4DB8FF"
                                FontSize="34"
                                FontAttributes="Bold"
                                VerticalOptions="Center"
                                InputTransparent="True" />

                        </Grid>

                    </Grid>

                </Border>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>