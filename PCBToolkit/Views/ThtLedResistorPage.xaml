<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="PCBToolkit.Views.ThtLedResistorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#0B0F14">

    <!-- EN: Main page layout -->
    <!-- TR: Ana sayfa düzeni -->
    <Grid RowDefinitions="100,*">

        <!-- EN: Header area -->
        <!-- TR: Header alanı -->
        <Grid
            Grid.Row="0"
            HeightRequest="100"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">

            <Image
                Source="tht_led_resistor.png"
                Aspect="AspectFill"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                InputTransparent="True" />

            <BoxView
                BackgroundColor="#650B0F14"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                InputTransparent="True" />

            <Grid
                Padding="18,12"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="16"
                HorizontalOptions="Fill"
                VerticalOptions="Fill">

                <!-- EN: Page title -->
                <!-- TR: Sayfa başlığı -->
                <VerticalStackLayout
                    Grid.Column="0"
                    Spacing="2"
                    HorizontalOptions="Fill"
                    VerticalOptions="Center">

                    <Label
                        Text="LED Seri Direnç"
                        TextColor="White"
                        FontSize="24"
                        FontAttributes="Bold"
                        HorizontalOptions="Fill"
                        HorizontalTextAlignment="End"
                        LineBreakMode="TailTruncation"
                        MaxLines="1" />

                    <Label
                        Text="LED için gerekli seri direnci hesaplayın"
                        TextColor="#FF8A3D"
                        FontSize="12"
                        HorizontalOptions="Fill"
                        HorizontalTextAlignment="End"
                        LineBreakMode="TailTruncation"
                        MaxLines="1" />

                </VerticalStackLayout>

                <!-- EN: Back navigation button -->
                <!-- TR: Geri dönüş butonu -->
                <Border
                    Grid.Column="1"
                    WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="#B5101820"
                    Stroke="#FF8A3D"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 14"
                    HorizontalOptions="End"
                    VerticalOptions="Center">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>

                    <Grid
                        WidthRequest="44"
                        HeightRequest="44"
                        InputTransparent="True">

                        <Path
                            Data="M 8,9 L 15,16 L 8,23"
                            Stroke="#FF8A3D"
                            StrokeThickness="3"
                            StrokeLineCap="Round"
                            StrokeLineJoin="Round"
                            WidthRequest="23"
                            HeightRequest="32"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            InputTransparent="True" />

                    </Grid>

                </Border>

            </Grid>

            <BoxView
                HeightRequest="1"
                BackgroundColor="#6A3C21"
                HorizontalOptions="Fill"
                VerticalOptions="End"
                InputTransparent="True" />

        </Grid>

        <!-- EN: Scrollable responsive content -->
        <!-- TR: Kaydırılabilir responsive içerik -->
        <ScrollView
            Grid.Row="1"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            HorizontalScrollBarVisibility="Never"
            VerticalScrollBarVisibility="Default">

            <VerticalStackLayout
                Padding="20,18,20,30"
                Spacing="18"
                HorizontalOptions="Fill"
                MaximumWidthRequest="720">

                <!-- EN: Circuit values and LED preview -->
                <!-- TR: Devre değerleri ve LED önizlemesi -->
                <Border
                    Padding="16"
                    BackgroundColor="#101820"
                    Stroke="#49301F"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    HorizontalOptions="Fill">

                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="18"
                        HorizontalOptions="Fill">

                        <!-- EN: Circuit value inputs -->
                        <!-- TR: Devre değer girişleri -->
                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="14"
                            HorizontalOptions="Fill"
                            VerticalOptions="Center">

                            <Label
                                Text="Devre Değerleri"
                                TextColor="White"
                                FontSize="16"
                                FontAttributes="Bold"
                                HorizontalOptions="Fill" />

                            <VerticalStackLayout
                                Spacing="5"
                                HorizontalOptions="Fill">

                                <Label
                                    Text="Besleme Voltajı (V)"
                                    TextColor="#AAB6C0"
                                    FontSize="13"
                                    HorizontalOptions="Fill" />

                                <Entry
                                    x:Name="SupplyVoltageEntry"
                                    Placeholder="Örn: 5"
                                    Keyboard="Numeric"
                                    TextColor="White"
                                    PlaceholderColor="#566674"
                                    BackgroundColor="#0B0F14"
                                    HorizontalOptions="Fill" />

                            </VerticalStackLayout>

                            <VerticalStackLayout
                                Spacing="5"
                                HorizontalOptions="Fill">

                                <Label
                                    Text="LED İleri Yön Voltajı (V)"
                                    TextColor="#AAB6C0"
                                    FontSize="13"
                                    HorizontalOptions="Fill" />

                                <Entry
                                    x:Name="LedVoltageEntry"
                                    Placeholder="Örn: 2"
                                    Keyboard="Numeric"
                                    TextColor="White"
                                    PlaceholderColor="#566674"
                                    BackgroundColor="#0B0F14"
                                    HorizontalOptions="Fill" />

                            </VerticalStackLayout>

                            <VerticalStackLayout
                                Spacing="5"
                                HorizontalOptions="Fill">

                                <Label
                                    Text="LED Akımı (mA)"
                                    TextColor="#AAB6C0"
                                    FontSize="13"
                                    HorizontalOptions="Fill" />

                                <Entry
                                    x:Name="LedCurrentEntry"
                                    Placeholder="Örn: 20"
                                    Keyboard="Numeric"
                                    TextColor="White"
                                    PlaceholderColor="#566674"
                                    BackgroundColor="#0B0F14"
                                    HorizontalOptions="Fill" />

                            </VerticalStackLayout>

                        </VerticalStackLayout>

                        <!-- EN: LED visual and glow area -->
                        <!-- TR: LED görseli ve ışık alanı -->
                        <Grid
                            Grid.Column="1"
                            WidthRequest="105"
                            HeightRequest="220"
                            MaximumWidthRequest="120"
                            VerticalOptions="Center"
                            HorizontalOptions="Center">

                            <!-- EN: Wide ambient glow behind the LED -->
                            <!-- TR: LED arkasındaki geniş ortam ışığı -->
                            <Ellipse
                                x:Name="LedOuterGlow"
                                WidthRequest="100"
                                HeightRequest="100"
                                Fill="Transparent"
                                Opacity="0"
                                HorizontalOptions="Center"
                                VerticalOptions="Start"
                                Margin="0,12,0,0"
                                InputTransparent="True">

                                <Ellipse.Shadow>
                                    <Shadow
                                        Brush="Transparent"
                                        Radius="38"
                                        Opacity="0.9"
                                        Offset="0,0" />
                                </Ellipse.Shadow>

                            </Ellipse>

                            <!-- EN: Concentrated glow around the LED dome -->
                            <!-- TR: LED kubbesinin çevresindeki yoğun ışık -->
                            <Ellipse
                                x:Name="LedInnerGlow"
                                WidthRequest="72"
                                HeightRequest="72"
                                Fill="Transparent"
                                Opacity="0"
                                HorizontalOptions="Center"
                                VerticalOptions="Start"
                                Margin="0,25,0,0"
                                InputTransparent="True">

                                <Ellipse.Shadow>
                                    <Shadow
                                        Brush="Transparent"
                                        Radius="22"
                                        Opacity="1"
                                        Offset="0,0" />
                                </Ellipse.Shadow>

                            </Ellipse>

                            <!-- EN: Internal light visible through the clear LED body -->
                            <!-- TR: Şeffaf LED gövdesinin içinden görünen iç ışık -->
                            <Ellipse
                                x:Name="LedCore"
                                WidthRequest="45"
                                HeightRequest="45"
                                Fill="Transparent"
                                Opacity="0"
                                HorizontalOptions="Center"
                                VerticalOptions="Start"
                                Margin="0,38,0,0"
                                InputTransparent="True" />

                            <!-- EN: Clear LED body -->
                            <!-- TR: Şeffaf LED gövdesi -->
                            <Image
                                x:Name="LedImage"
                                Source="tht_led.png"
                                WidthRequest="100"
                                HeightRequest="210"
                                Aspect="AspectFit"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                InputTransparent="True" />

                        </Grid>

                    </Grid>

                </Border>

                <!-- EN: Calculation actions -->
                <!-- TR: Hesaplama işlemleri -->
                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="10"
                    HorizontalOptions="Fill">

                    <Button
                        x:Name="CalculateButton"
                        Grid.Column="0"
                        Text="HESAPLA"
                        HeightRequest="52"
                        BackgroundColor="#FF8A3D"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HorizontalOptions="Fill"
                        Clicked="OnCalculateClicked" />

                    <Button
                        x:Name="ClearButton"
                        Grid.Column="1"
                        Text="TEMİZLE"
                        HeightRequest="52"
                        BackgroundColor="#101820"
                        TextColor="#AAB6C0"
                        BorderColor="#49301F"
                        BorderWidth="1"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HorizontalOptions="Fill"
                        Clicked="OnClearClicked" />

                </Grid>

                <!-- EN: Calculation result card -->
                <!-- TR: Hesaplama sonuç kartı -->
                <Border
                    x:Name="ResultCard"
                    Padding="18"
                    BackgroundColor="#101820"
                    Stroke="#49301F"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    HorizontalOptions="Fill">

                    <VerticalStackLayout
                        Spacing="10"
                        HorizontalOptions="Fill">

                        <Label
                            Text="Sonuç"
                            TextColor="#7F8C96"
                            FontSize="12"
                            HorizontalOptions="Fill" />

                        <Label
                            x:Name="ResistanceResultLabel"
                            Text="— Ω"
                            TextColor="#FF8A3D"
                            FontSize="28"
                            FontAttributes="Bold"
                            HorizontalOptions="Fill"
                            LineBreakMode="WordWrap" />

                        <BoxView
                            HeightRequest="1"
                            Color="#49301F"
                            HorizontalOptions="Fill" />

                        <!-- EN: Additional result information -->
                        <!-- TR: Ek sonuç bilgileri -->
                        <Grid
                            ColumnDefinitions="Auto,*"
                            RowDefinitions="Auto,Auto"
                            RowSpacing="10"
                            ColumnSpacing="16"
                            HorizontalOptions="Fill">

                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="Direnç Gücü"
                                TextColor="#7F8C96"
                                VerticalOptions="Start" />

                            <Label
                                x:Name="PowerResultLabel"
                                Grid.Row="0"
                                Grid.Column="1"
                                Text="— W"
                                TextColor="White"
                                HorizontalOptions="Fill"
                                HorizontalTextAlignment="End"
                                LineBreakMode="WordWrap" />

                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="Hesap"
                                TextColor="#7F8C96"
                                VerticalOptions="Start" />

                            <Label
                                x:Name="CalculationLabel"
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="—"
                                TextColor="White"
                                HorizontalOptions="Fill"
                                HorizontalTextAlignment="End"
                                LineBreakMode="WordWrap" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>