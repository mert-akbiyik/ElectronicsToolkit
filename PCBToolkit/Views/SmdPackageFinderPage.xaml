<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PCBToolkit.Views.SmdPackageFinderPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#0B0F14">

    <!-- EN: Main page layout -->
    <!-- TR: Sayfanın ana düzeni -->
    <Grid RowDefinitions="100,*">

        <!-- EN: Header area -->
        <!-- TR: Header alanı -->
        <Grid
            Grid.Row="0"
            HeightRequest="100"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">

            <!-- EN: Header background image -->
            <!-- TR: Header arka plan görseli -->
            <Image
                Source="smd_package_finder.png"
                Aspect="AspectFill"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                InputTransparent="True" />

            <!-- EN: Header readability overlay -->
            <!-- TR: Header okunabilirlik katmanı -->
            <BoxView
                BackgroundColor="#650B0F14"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                InputTransparent="True" />

            <!-- EN: Header content -->
            <!-- TR: Header içeriği -->
            <Grid
                Padding="18,12"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="16">

                <!-- EN: Back navigation button -->
                <!-- TR: Geri dönüş butonu -->
                <Border
                    Grid.Column="0"
                    WidthRequest="44"
                    HeightRequest="44"
                    BackgroundColor="#B5101820"
                    Stroke="#4DB8FF"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 14"
                    HorizontalOptions="Start"
                    VerticalOptions="Center">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>

                    <Grid
                        WidthRequest="44"
                        HeightRequest="44"
                        InputTransparent="True">

                        <!-- EN: Geometric back arrow -->
                        <!-- TR: Geometrik geri oku -->
                        <Path
                            Data="M 15,9 L 8,16 L 15,23"
                            Stroke="#4DB8FF"
                            StrokeThickness="3"
                            StrokeLineCap="Round"
                            StrokeLineJoin="Round"
                            WidthRequest="23"
                            HeightRequest="32"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            InputTransparent="True" />

                    </Grid>

                </Border>

                <!-- EN: Page title -->
                <!-- TR: Sayfa başlığı -->
                <Label
                    Grid.Column="1"
                    Text="Paket Bulucu"
                    TextColor="White"
                    FontSize="24"
                    FontAttributes="Bold"
                    VerticalOptions="Center"
                    LineBreakMode="TailTruncation"
                    MaxLines="1" />

            </Grid>

            <!-- EN: Header bottom divider -->
            <!-- TR: Header alt ayırıcı -->
            <BoxView
                HeightRequest="1"
                BackgroundColor="#17384D"
                HorizontalOptions="Fill"
                VerticalOptions="End"
                InputTransparent="True" />

        </Grid>

        <!-- EN: Scrollable main content -->
        <!-- TR: Kaydırılabilir ana içerik -->
        <ScrollView
            Grid.Row="1"
            HorizontalScrollBarVisibility="Never"
            VerticalScrollBarVisibility="Default">

            <VerticalStackLayout
                Padding="20,18,20,30"
                Spacing="20"
                HorizontalOptions="Fill"
                MaximumWidthRequest="720">

                <!-- EN: Package selection -->
                <!-- TR: Paket seçimi -->
                <VerticalStackLayout Spacing="8">

                    <Label
                        Text="Paketler"
                        TextColor="#AAB6C0"
                        FontSize="13"
                        FontAttributes="Bold" />

                    <Picker
                        x:Name="PackagePicker"
                        TextColor="White"
                        BackgroundColor="#101820"
                        HorizontalOptions="Fill"
                        SelectedIndexChanged="OnPackageSelected" />

                </VerticalStackLayout>

                <!-- EN: Technical package information -->
                <!-- TR: Teknik paket bilgileri -->
                <Border
                    x:Name="PackageInfoCard"
                    Padding="20"
                    BackgroundColor="#0D1B25"
                    Stroke="#168BD2"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    HorizontalOptions="Fill">

                    <VerticalStackLayout Spacing="14">

                        <Label
                            Text="PAKET BİLGİLERİ"
                            TextColor="#71808E"
                            FontSize="11"
                            FontAttributes="Bold"
                            CharacterSpacing="1.5" />

                        <Grid
                            ColumnDefinitions="*,*"
                            RowDefinitions="Auto,Auto,Auto,Auto"
                            RowSpacing="12"
                            ColumnSpacing="10">

                            <!-- EN: Imperial package code -->
                            <!-- TR: Imperial paket kodu -->
                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="Imperial"
                                TextColor="#8998A5" />

                            <Label
                                x:Name="ImperialLabel"
                                Grid.Row="0"
                                Grid.Column="1"
                                Text="—"
                                TextColor="White"
                                FontAttributes="Bold" />

                            <!-- EN: Metric package code -->
                            <!-- TR: Metric paket kodu -->
                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="Metric"
                                TextColor="#8998A5" />

                            <Label
                                x:Name="MetricLabel"
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="—"
                                TextColor="White"
                                FontAttributes="Bold" />

                            <!-- EN: Package length -->
                            <!-- TR: Paket uzunluğu -->
                            <Label
                                Grid.Row="2"
                                Grid.Column="0"
                                Text="Uzunluk"
                                TextColor="#8998A5" />

                            <Label
                                x:Name="LengthLabel"
                                Grid.Row="2"
                                Grid.Column="1"
                                Text="—"
                                TextColor="#4DB8FF"
                                FontAttributes="Bold" />

                            <!-- EN: Package width -->
                            <!-- TR: Paket genişliği -->
                            <Label
                                Grid.Row="3"
                                Grid.Column="0"
                                Text="Genişlik"
                                TextColor="#8998A5" />

                            <Label
                                x:Name="WidthLabel"
                                Grid.Row="3"
                                Grid.Column="1"
                                Text="—"
                                TextColor="#4DB8FF"
                                FontAttributes="Bold" />

                        </Grid>

                        <!-- EN: Selected package description -->
                        <!-- TR: Seçilen paket açıklaması -->
                        <Label
                            x:Name="DescriptionLabel"
                            Margin="0,5,0,0"
                            Text="Bir paket seçerek teknik bilgilerini görüntüleyebilirsiniz."
                            TextColor="#8998A5"
                            FontSize="13"
                            LineBreakMode="WordWrap" />

                    </VerticalStackLayout>

                </Border>

                <!-- EN: Package dimensions and official visual sources -->
                <!-- TR: Paket ölçüleri ve resmî görsel kaynakları -->
                <Border
                    Padding="14"
                    BackgroundColor="#0F1720"
                    Stroke="#263746"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    HorizontalOptions="Fill">

                    <VerticalStackLayout Spacing="10">

                        <!-- EN: Dimension information -->
                        <!-- TR: Ölçü bilgisi -->
                        <Label
                            Text="Bilgi: Gösterilen ölçüler nominal paket ölçüleridir. Üretici ve ürün serisine göre küçük tolerans veya kodlama farklılıkları görülebilir. Örneğin bazı üreticilerde 2512 paketi 6432 yerine 6332 olarak adlandırılabilir."
                            TextColor="#7F8C96"
                            FontSize="12"
                            LineBreakMode="WordWrap" />

                        <!-- EN: Visual source information -->
                        <!-- TR: Görsel kaynak açıklaması -->
                        <Label
                            Margin="0,4,0,0"
                            Text="SMD paketlerinin gerçek ürün görsellerine ve üretici teknik bilgilerine aşağıdaki resmî kaynaklardan ulaşabilirsiniz:"
                            TextColor="#AAB6C0"
                            FontSize="12"
                            LineBreakMode="WordWrap" />

                        <!-- EN: Official KYOCERA AVX source -->
                        <!-- TR: KYOCERA AVX resmî kaynağı -->
                        <Label
                            Text="KYOCERA AVX — Surface Mount Guide"
                            TextColor="#4DB8FF"
                            FontSize="12"
                            FontAttributes="Bold"
                            LineBreakMode="WordWrap" />

                        <!-- EN: Official Vishay source -->
                        <!-- TR: Vishay resmî kaynağı -->
                        <Label
                            Text="Vishay — SMD Chip Resistors"
                            TextColor="#4DB8FF"
                            FontSize="12"
                            FontAttributes="Bold"
                            LineBreakMode="WordWrap" />

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>